# ============================================================================
# Quackback production environment — for docker-compose.prod.yml
# ============================================================================
# Copy to .env (in the repo root, next to docker-compose.prod.yml), fill in
# EVERY value below, then:
#   docker compose -f docker-compose.prod.yml up -d
#
# Rules (Docker reads these literally):
#   - no quotes around values
#   - no inline "# comments" on a value line
#
# You do NOT set DATABASE_URL / S3_ENDPOINT / S3 keys here — the
# prod compose builds those from the secrets below and wires them to the
# internal services automatically.
#
# Five values are REQUIRED: without them the stack refuses to start rather than
# booting half-configured — POSTGRES_USER, POSTGRES_PASSWORD, MINIO_ROOT_USER,
# MINIO_ROOT_PASSWORD and MINIO_LICENSE.

# --- Application ---------------------------------------------------------
# Public URL of your instance (auth, emails and OAuth callbacks depend on it).
BASE_URL=http://localhost:3000

# Session signing + encryption key. MUST be >= 32 chars.
# Generate with: openssl rand -base64 32
SECRET_KEY=

# Published image tag to run.
# Keep `main` for now: the released images (latest = 0.13.2) predate the move of
# jobs, KV, presence and realtime from Redis to Postgres. They still require
# REDIS_URL — which this compose deliberately does not provide — so the app
# fails every request with `config validation failed: redisUrl` and never turns
# healthy; they also lack /api/health/ready, the route the healthcheck probes.
# Pin a release (e.g. 0.14.x) once one ships with that change.
QUACKBACK_TAG=main

# Host port to publish the app on (the container always listens on 3000).
APP_PORT=3000

# --- PostgreSQL (internal `postgres` service) ----------------------------
# REQUIRED. The credentials are baked into the postgres volume on FIRST boot:
# changing them later does not re-initialize the database, it just makes every
# service fail to authenticate until the volume is recreated.
POSTGRES_USER=quackback
# Generate with: openssl rand -base64 24
POSTGRES_PASSWORD=
POSTGRES_DB=quackback

# --- Object storage (internal `minio` service) ---------------------------
# REQUIRED. These double as the S3 access key / secret the app uses.
MINIO_ROOT_USER=quackback
# Generate with: openssl rand -base64 24
MINIO_ROOT_PASSWORD=
S3_BUCKET=quackback
S3_REGION=us-east-1

# Serve uploads from a CDN or public bucket URL instead of the app's
# /api/storage proxy. Leave empty for the bundled (private) MinIO.
S3_PUBLIC_URL=

# REQUIRED — MinIO AIStor license. The stack refuses to start without it.
# Get one at https://min.io (the FREE plan covers a single-node deployment) and
# paste the token on a single line, no quotes. Without a valid license AIStor
# boots into offline mode and denies every S3 operation, so uploads break.
MINIO_LICENSE=

# Bundled MinIO AIStor image tags (pin to a specific RELEASE.* in prod).
# MINIO_IMAGE_TAG=RELEASE.2026-09-07T08-39-31Z
# MC_IMAGE_TAG=RELEASE.2026-09-06T02-44-40Z

# --- Email (required for invites, magic links, notifications) ------------
# SMTP (works with any provider). Leave blank to log emails to the console.
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
EMAIL_FROM=Quackback <noreply@example.com>
# Uncomment for port 465 (implicit TLS):
# EMAIL_SMTP_SECURE=true
# Or use the Amazon SES API instead of SMTP. All three are required: the
# region is the one the sending identity is verified in, and there is no
# default because a verified identity is regional.
# EMAIL_SES_ACCESS_KEY_ID=
# EMAIL_SES_SECRET_ACCESS_KEY=
# EMAIL_SES_REGION=us-east-1

# --- Inbound email (optional) — conversation email channel ---------------
# Lets a visitor reply to an agent's email and have it thread back into the
# conversation. Either a provider webhook (both values) or IMAP polling.
# EMAIL_INBOUND_DOMAIN=
# EMAIL_INBOUND_SIGNING_SECRET=
# EMAIL_INBOUND_PROVIDER=imap
# IMAP_HOST=
# IMAP_PORT=993
# IMAP_USER=
# IMAP_PASSWORD=
# IMAP_MAILBOX=INBOX

# --- AI (optional) -------------------------------------------------------
# Enables summaries, duplicate detection, feedback extraction, etc. All AI
# features stay OFF unless BOTH a key and an explicit base URL are set — there
# is no implicit provider default.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# A feature is enabled only when its model resolves to a value: chat features
# need AI_CHAT_MODEL, duplicate detection and semantic search need
# AI_EMBEDDING_MODEL. Per-feature overrides (AI_SUMMARY_MODEL, ...) are optional.
# AI_CHAT_MODEL=gpt-4o-mini
# AI_EMBEDDING_MODEL=text-embedding-3-small

# --- Operations (optional) -----------------------------------------------
# trace | debug | info | warn | error | fatal | silent (default: info in prod)
LOG_LEVEL=info
# all (default) | web | worker — single-container deployments want `all`.
QUACKBACK_ROLE=all
# Trusted reverse-proxy hops allowed to supply client-IP headers (0 = none).
# Set to 1 when the app sits behind one proxy (Caddy, nginx, Cloudflare).
# TRUSTED_PROXY_HOPS=0
# Anonymous usage statistics are on by default; uncomment to disable.
# DISABLE_TELEMETRY=true
